{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/JobTrail.slnx"],
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "test",
      "command": "dotnet",
      "type": "process",
      "args": ["test", "${workspaceFolder}/JobTrail.slnx"],
      "problemMatcher": "$msCompile",
      "group": "test"
    },
    {
      "label": "watch-run",
      "command": "dotnet",
      "type": "process",
      "args": ["watch", "run", "--project", "${workspaceFolder}/JobTrail.App/JobTrail.App.csproj"],
      "problemMatcher": "$msCompile",
      "isBackground": true
    }
  ]
}
